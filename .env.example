# ---------------------------------------------------------------------------
# ROOT .env — BUILD-TIME environment for Docker Compose ($VAR interpolation).
#
# These control the host's Module Federation remote base URLs, which are baked
# into the host bundle at build time by Vite. Change them to your deployed
# domains, then REBUILD the host:
#
#   docker compose build host-dashboard
#   docker compose up -d
#
# (They are NOT read from the per-app .env, which is runtime-only for nginx.)
# ---------------------------------------------------------------------------

# Remote base URLs the host uses to reach each micro-frontend in the BROWSER.
VITE_REMOTE_COMPONENTS_URL=http://localhost:3002
VITE_REMOTE_AUTH_URL=http://localhost:3001
VITE_REMOTE_VUE_URL=http://localhost:3003
