VITE_APP_NAME="Micro Front-end"
VITE_BASE_API_URL=http://localhost:8080

# Module Federation remote base URLs. These fall back to the published
# localhost ports (http://localhost:3002 / 3001 / 3003) when unset, so you only
# need them to point the host at Docker service names or an ingress — e.g.:
#
#   VITE_REMOTE_COMPONENTS_URL=http://remote-components:80
#   VITE_REMOTE_AUTH_URL=http://remote-auth:80
#   VITE_REMOTE_VUE_URL=http://remote-vue:80
#
# Keep these commented out here. They are supplied at build time either as
# Docker Compose build args (see docker-compose.yml) or as your shell
# environment, which take precedence over `.env` values:
#
#   VITE_REMOTE_COMPONENTS_URL=http://localhost:3002
#   VITE_REMOTE_AUTH_URL=http://localhost:3001
#   VITE_REMOTE_VUE_URL=http://localhost:3003
